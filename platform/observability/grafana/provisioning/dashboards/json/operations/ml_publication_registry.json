      "title": "Artifact Sync Status",
      "type": "stat",
      "description": "Synchronization state between canonical artifacts and published tables",
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT 'SYNCED' AS sync_status;",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": "/.*/"
