          "format": "time_series",
          "rawSql": "SELECT prediction_date AS time, round(sum(actual)::numeric, 0) as \"Observed Demand\", round(sum(prediction)::numeric, 0) as \"Forecasted Demand\" FROM ml_results.forecasting_v1_predictions GROUP BY 1 ORDER BY 1;",
          "refId": "A"
