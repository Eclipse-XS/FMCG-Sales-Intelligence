        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT COUNT(DISTINCT store_id) FROM ml_results.segmentation_v1_assignments;",
          "refId": "A"
