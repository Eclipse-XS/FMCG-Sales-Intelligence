            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "WITH thresholds AS (    SELECT generate_series(0, 100)::numeric / 100.0 as thresh), classified AS (    SELECT t.thresh, p.stockout_within_7d as actual, (p.predicted_probability >= t.thresh) as pred     FROM thresholds t CROSS JOIN ml_results.stockout_classification_v1_predictions p), matrix AS (    SELECT thresh, sum(case when actual and pred then 1 else 0 end) as tp, sum(case when not actual and pred then 1 else 0 end) as fp, sum(case when actual and not pred then 1 else 0 end) as fn, sum(case when not actual and not pred then 1 else 0 end) as tn     FROM classified GROUP BY thresh) SELECT round((fp::numeric / nullif(fp + tn, 0))::numeric, 4) as fpr, round((tp::numeric / nullif(tp + fn, 0))::numeric, 4) as tpr, round((fp::numeric / nullif(fp + tn, 0))::numeric, 4) as chance_line FROM matrix ORDER BY fpr ASC, tpr ASC;",
          "refId": "A"
        }
      ],
      "options": {
