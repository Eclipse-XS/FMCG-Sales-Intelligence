      },
      "fieldConfig": {
        "defaults": {
          "unit": "string",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Presentation Rows by Scientific Core",
      "type": "barchart",
      "description": "Row distribution across the 7 governed scientific cores",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT core, sum(row_count) as total_rows FROM ml_results.publication_manifest GROUP BY 1 ORDER BY 2 DESC;",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "xField": null,
        "legend": {
          "displayMode": "list",
