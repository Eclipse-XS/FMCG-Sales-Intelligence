    {
      "id": 9,
      "title": "Threshold Diagnostics (Precision, Recall & F1-Score)",
      "type": "xychart",
      "pluginVersion": "11.5.2",
      "description": "Trade-off curves of Precision, Recall, and F1 across candidate operational decision thresholds",
      "gridPos": {
