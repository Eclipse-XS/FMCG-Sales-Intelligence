{
  "title": "FMCG Business Overview",
  "uid": "fmcg_biz_overview",
  "timezone": "browser",
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": [
    "business",
    "executive",
    "fmcg"
  ],
  "time": {
    "from": "2024-01-01T00:00:00.000Z",
    "to": "2024-03-31T23:59:59.000Z"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Executive Commercial Context",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**FMCG Operational Intelligence Platform** \u2014 Executive sales performance, category revenue contribution, and retail footprint coverage.\n*Source:* Authoritative sales and product entities (`fmcg.sales`, `fmcg.stores`, `fmcg.products`, `fmcg.categories`)."
      }
    },
    {
      "id": 2,
      "title": "Total Gross Revenue",
      "type": "stat",
      "description": "Aggregate gross sales revenue across retail network",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT sum(gross_revenue) AS value FROM fmcg.sales;",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Total Physical Units Sold",
      "type": "stat",
      "description": "Total physical units sold across all active SKUs",
      "gridPos": {
        "x": 6,
        "y": 2,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT sum(quantity_units) AS value FROM fmcg.sales;",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Sales Transactions Recorded",
      "type": "stat",
      "description": "Total distinct point-of-sale receipt checkout events",
      "gridPos": {
        "x": 12,
        "y": 2,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT count(sale_id) AS value FROM fmcg.sales;",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Active Retail Stores",
      "type": "stat",
      "description": "Total monitored brick-and-mortar retail outlets",
      "gridPos": {
        "x": 18,
        "y": 2,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT count(distinct store_id) AS value FROM fmcg.stores;",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Daily Revenue Trajectory (30-Day Window)",
      "type": "timeseries",
      "description": "Chain-wide daily gross sales revenue trajectory",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "time_series",
          "rawSql": "SELECT sale_date AS time, sum(gross_revenue) AS revenue FROM fmcg.sales WHERE sale_date >= '2024-03-01' GROUP BY 1 ORDER BY 1;",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "revenue"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "Revenue Share by Product Category",
      "type": "barchart",
      "description": "Gross revenue contribution by commercial product category",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT c.category_name as category, round(sum(s.gross_revenue)::numeric, 2) as revenue FROM fmcg.sales s JOIN fmcg.skus k ON s.sku_id = k.sku_id JOIN fmcg.products p ON k.product_id = p.product_id JOIN fmcg.categories c ON p.category_id = c.category_id GROUP BY 1 ORDER BY 2 DESC;",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "xField": null,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Top 10 Revenue-Generating SKUs",
      "type": "barchart",
      "description": "Top 10 individual product lines by total gross sales volume",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT concat(p.product_name, ' [SKU ', s.sku_id, ']') as sku_label, round(sum(s.gross_revenue)::numeric, 2) as revenue FROM fmcg.sales s JOIN fmcg.skus k ON s.sku_id = k.sku_id JOIN fmcg.products p ON k.product_id = p.product_id GROUP BY 1, p.product_name ORDER BY 2 DESC LIMIT 10;",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "xField": null,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Regional Performance Summary",
      "type": "barchart",
      "description": "Sales distribution across geographic distribution zones",
      "gridPos": {
        "x": 14,
        "y": 13,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT r.region_name as region, round(sum(s.gross_revenue)::numeric, 2) as revenue FROM fmcg.sales s JOIN fmcg.stores st ON s.store_id = st.store_id JOIN fmcg.regions r ON st.region_id = r.region_id GROUP BY 1 ORDER BY 2 DESC;",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "xField": null,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Store Commercial Performance Summary",
      "type": "table",
      "description": "Exhaustive commercial performance ledger by retail outlet",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT st.store_id, st.store_name, r.region_name, st.store_type, st.channel, sum(s.quantity_units) as total_units, round(sum(s.gross_revenue)::numeric, 2) as total_revenue, count(s.sale_id) as total_transactions FROM fmcg.sales s JOIN fmcg.stores st ON s.store_id = st.store_id JOIN fmcg.regions r ON st.region_id = r.region_id GROUP BY 1, 2, 3, 4, 5 ORDER BY total_revenue DESC;",
          "refId": "A"
        }
      ],
      "options": {
        "footer": {
          "enablePagination": true,
          "show": true
        },
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total_revenue"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "custom.displayName",
                "value": "Total Revenue"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "total_units"
            },
            "properties": [
              {
                "id": "custom.displayName",
                "value": "Units Sold"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "total_transactions"
            },
            "properties": [
              {
                "id": "custom.displayName",
                "value": "Transactions"
              }
            ]
          }
        ]
      }
    }
  ]
}