    {
      "id": 8,
      "title": "Observed vs Predicted Daily Demand Trajectory",
      "type": "timeseries",
      "description": "Total actual store sales volume vs model forecasts across the 20-day evaluation window",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
