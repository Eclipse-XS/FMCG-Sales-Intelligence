    {
      "id": 9,
      "title": "Promotion Performance Summary Table",
      "type": "table",
      "description": "Comprehensive promotional campaign benchmarking table",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT concat('Promo ', promotion_id) as campaign, to_char(start_date, 'YYYY-MM-DD') as start_date, to_char(end_date, 'YYYY-MM-DD') as end_date, duration_days, exposure_count, round(pre_units_per_day::numeric, 1) as pre_velocity, round(during_units_per_day::numeric, 1) as promo_velocity, round(coalesce(post_units_per_day, 0)::numeric, 1) as post_velocity, round((during_vs_pre_relative_units_change * 100)::numeric, 1) as units_lift_pct, round((during_vs_pre_relative_revenue_change * 100)::numeric, 1) as revenue_lift_pct FROM ml_results.promotion_v1_summary ORDER BY promotion_id;",
          "refId": "A"
        }
