    {
      "id": 7,
      "title": "Receiver Operating Characteristic (ROC) Curve",
      "type": "xychart",
      "pluginVersion": "11.5.2",
      "description": "True Positive Rate vs False Positive Rate curve evaluating global model discrimination (AUC = 0.799)",
      "gridPos": {
