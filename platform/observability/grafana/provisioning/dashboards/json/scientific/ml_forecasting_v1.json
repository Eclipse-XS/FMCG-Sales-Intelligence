    {
      "id": 12,
      "title": "Test Predictions Inspection & Error Diagnostics",
      "type": "table",
      "description": "Granular out-of-sample prediction episodes sorted by absolute residual error",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT to_char(prediction_date, 'YYYY-MM-DD') as date, store_id, sku_id, category_name, demand_volume_group, round(actual::numeric, 1) as actual_units, round(prediction::numeric, 1) as predicted_units, round(residual::numeric, 1) as error_units, round((abs(residual) / nullif(actual, 0) * 100)::numeric, 1) as abs_pct_error FROM ml_results.forecasting_v1_predictions ORDER BY abs(residual) DESC LIMIT 200;",
          "refId": "A"
        }
      ],
      "options": {
        "footer": {
          "enablePagination": true,
          "show": true
        },
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
