          },
          "format": "table",
          "rawSql": "SELECT category_name as category, round((avg(during_vs_pre_relative_units_change) * 100)::numeric, 1) as avg_units_lift_pct FROM ml_results.promotion_v1_exposure WHERE during_vs_pre_relative_units_change IS NOT NULL GROUP BY 1 ORDER BY 2 DESC;",
