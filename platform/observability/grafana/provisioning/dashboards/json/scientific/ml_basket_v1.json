                "options": "Moderate Affinity (Lift 1.45 - 1.55)"
              }
            },
            "name": {
              "fixed": "Moderate Affinity (Lift 1.45 - 1.55)"
            }
          },
          {
            "frame": {
              "matcher": {
                "id": "byIndex",
                "options": 0
              }
            },
