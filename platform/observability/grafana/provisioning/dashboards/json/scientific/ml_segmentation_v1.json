      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT temporal_assignment_retention * 100 FROM ml_results.segmentation_v1_metrics LIMIT 1;",
          "refId": "A"
