    {
      "id": 6,
      "title": "Precision\u2013Recall Curve (Imbalance Diagnostic)",
      "type": "xychart",
      "pluginVersion": "11.5.2",
      "description": "Empirical Precision-Recall trade-off curve across classification thresholds vs positive base rate",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres_db"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "WITH thresholds AS (    SELECT generate_series(1, 99)::numeric / 100.0 as thresh), prevalence AS (    SELECT round((sum(case when stockout_within_7d then 1 else 0 end)::numeric / count(*)::numeric)::numeric, 4) as base_rate     FROM ml_results.stockout_classification_v1_predictions), classified AS (    SELECT t.thresh, p.stockout_within_7d as actual, (p.predicted_probability >= t.thresh) as pred     FROM thresholds t CROSS JOIN ml_results.stockout_classification_v1_predictions p), matrix AS (    SELECT thresh, sum(case when actual and pred then 1 else 0 end) as tp, sum(case when not actual and pred then 1 else 0 end) as fp, sum(case when actual and not pred then 1 else 0 end) as fn     FROM classified GROUP BY thresh) SELECT round((tp::numeric / nullif(tp + fn, 0))::numeric, 4) as recall, round((tp::numeric / nullif(tp + fp, 0))::numeric, 4) as precision, prev.base_rate as baseline_prevalence FROM matrix CROSS JOIN prevalence prev WHERE tp + fp > 0 ORDER BY recall ASC, precision DESC;",
          "refId": "A"
        }
      ],
      "options": {
        "mapping": "manual",
        "series": [
          {
            "frame": {
              "matcher": {
                "id": "byIndex",
                "options": 0
              }
            },
            "x": {
              "matcher": {
                "id": "byName",
                "options": "recall"
              }
            },
            "y": {
              "matcher": {
                "id": "byName",
                "options": "precision"
              }
            },
            "name": {
              "fixed": "Precision-Recall Curve"
            }
          },
          {
            "frame": {
              "matcher": {
                "id": "byIndex",
                "options": 0
              }
            },
            "x": {
              "matcher": {
                "id": "byName",
                "options": "recall"
              }
            },
            "y": {
              "matcher": {
                "id": "byName",
                "options": "baseline_prevalence"
              }
            },
            "name": {
              "fixed": "Class Prevalence Baseline (4.84%)"
            }
          }
        ],
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
