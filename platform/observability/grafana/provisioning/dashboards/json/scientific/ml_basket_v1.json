    {
      "id": 6,
      "title": "Support vs. Confidence Scatter with Statistical Lift Encoding",
      "type": "xychart",
      "pluginVersion": "11.5.2",
      "description": "Association rule confidence vs basket support trade-off with statistical lift tier color encoding",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres_db"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT round((support * 100)::numeric, 2) as support_pct,        case when lift >= 1.55 then round((confidence * 100)::numeric, 1) end as \"High Affinity (Lift >= 1.55)\",        case when lift >= 1.45 and lift < 1.55 then round((confidence * 100)::numeric, 1) end as \"Moderate Affinity (Lift 1.45 - 1.55)\",        case when lift < 1.45 then round((confidence * 100)::numeric, 1) end as \"Standard Affinity (Lift < 1.45)\" FROM ml_results.basket_v1_rules ORDER BY support_pct ASC;",
          "refId": "A"
        }
      ],
      "options": {
        "mapping": "manual",
        "series": [
          {
            "frame": {
              "matcher": {
                "id": "byIndex",
                "options": 0
              }
            },
            "x": {
              "matcher": {
