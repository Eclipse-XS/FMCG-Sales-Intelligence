          "format": "table",
          "rawSql": "SELECT case     when predicted_probability < 0.05 then '0.00 - 0.05'     when predicted_probability < 0.10 then '0.05 - 0.10'     when predicted_probability < 0.15 then '0.10 - 0.15'     when predicted_probability < 0.20 then '0.15 - 0.20'     when predicted_probability < 0.25 then '0.20 - 0.25'     when predicted_probability < 0.30 then '0.25 - 0.30'     when predicted_probability < 0.40 then '0.30 - 0.40'     when predicted_probability < 0.50 then '0.40 - 0.50'     when predicted_probability < 0.60 then '0.50 - 0.60'     when predicted_probability < 0.70 then '0.60 - 0.70'     when predicted_probability < 0.80 then '0.70 - 0.80'     else '0.80 - 1.00' end as score_tier, sum(case when not stockout_within_7d then 1 else 0 end) as \"Actual Non-Stockouts\", sum(case when stockout_within_7d then 1 else 0 end) as \"Actual Stockouts\" FROM ml_results.stockout_classification_v1_predictions GROUP BY 1 ORDER BY min(predicted_probability);",
          "refId": "A"
        }
