    {
      "id": 11,
      "title": "Mean Absolute Error by Category",
      "type": "barchart",
      "description": "Forecast accuracy variance across commercial product categories",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_db"
          },
          "format": "table",
          "rawSql": "SELECT category_name as category, round(avg(abs(residual))::numeric, 2) as mae FROM ml_results.forecasting_v1_predictions GROUP BY 1 ORDER BY mae ASC;",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
